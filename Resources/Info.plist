<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CFBundleName is the label macOS shows in System Settings > Privacy & Security >
	     Automation. Keep it identical to the binary name so the toggle is recognisable. -->
	<key>CFBundleName</key>
	<string>apple-pages-mcp</string>
	<key>CFBundleIdentifier</key>
	<string>codes.eneko.apple-pages-mcp</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>

	<!-- Pages has no framework a separate process can use, so this server drives Pages.app
	     through Apple events. Sending one needs this key; without it macOS denies the
	     event without ever prompting. Key name verified against the tccd binary on
	     macOS 26.5. -->
	<key>NSAppleEventsUsageDescription</key>
	<string>Lets Claude read and manage your Pages documents through this local MCP server.</string>
</dict>
</plist>
